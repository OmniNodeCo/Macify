# PowerShell + batch must check out with CRLF so they run cleanly on stock Windows.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.html text eol=lf
*.ico binary
*.jpg binary
*.png binary
*.wav binary
